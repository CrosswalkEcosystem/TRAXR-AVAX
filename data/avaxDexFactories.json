{
  "network": "avax",
  "adapters": {
    "uniswap_v2": {
      "discovery": "factory_all_pairs",
      "poolState": "getReserves",
      "swapEvent": "Swap(address,uint256,uint256,uint256,uint256,address)"
    },
    "uniswap_v3": {
      "discovery": "factory_pool_created_logs",
      "poolState": "token_balances",
      "swapEvent": "Swap(address,address,int256,int256,uint160,uint128,int24)"
    },
    "joe_lb": {
      "discovery": "factory_lb_pair_created_logs",
      "poolState": "lb_bin_liquidity",
      "swapEvent": "Swap(address,address,uint24,bytes32,bytes32,uint256,uint256)",
      "status": "planned"
    },
    "curve": {
      "discovery": "registry_or_factory_logs",
      "poolState": "curve_virtual_price_balances",
      "swapEvent": "TokenExchange/TokenExchangeUnderlying",
      "status": "planned"
    },
    "balancer": {
      "discovery": "vault_pool_registered_logs",
      "poolState": "vault_pool_tokens",
      "swapEvent": "Swap(bytes32,address,address,uint256,uint256)",
      "status": "planned"
    },
    "uniswap_v4": {
      "discovery": "pool_manager_initialize_logs",
      "poolState": "positions_and_slot_state",
      "swapEvent": "Swap(...)",
      "status": "planned"
    }
  },
